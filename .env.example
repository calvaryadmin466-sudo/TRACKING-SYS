# Copy to .env and adjust. Never commit the real .env.

# --- Database ---
POSTGRES_USER=tracking
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=tracking
DB_PORT=5432

# --- Redis (reserved for Stage 2+) ---
REDIS_PORT=6379

# --- Ingestion server ---
# TCP port that devices connect to. Must match the port you set in the terminal's
# network -> ministry-standard server menu.
JT808_PORT=7808
INGEST_LOG_LEVEL=info
# Close a connection that sends nothing (not even a heartbeat) within this window.
INGEST_READ_TIMEOUT=5m

# --- Video (Stage 4, JT/T 1078) ---
# Media gateway TCP port (device video stream connections).
JT1078_PORT=7078
# Public host/IP advertised to devices in the 0x9101 command (your server's address).
PUBLIC_HOST=127.0.0.1
# Shared secret between the API and the ingestion server's internal control API.
CONTROL_TOKEN=change_me_in_env

# DATABASE_URL is composed from the POSTGRES_* values by docker-compose for the
# ingestion container. For running the server outside Docker, set it directly:
# DATABASE_URL=postgres://tracking:change_me_in_env@localhost:5432/tracking?sslmode=disable

# --- API service (Stage 2) ---
API_PORT=8080
# IMPORTANT: set a long random secret in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change_me_in_env
# development | production. In production the API refuses the default JWT secret
# and refuses to run the demo feed.
APP_ENV=development
# Domain for TLS via the Caddy reverse proxy (prod overlay). Blank = self-signed localhost.
DOMAIN=
# Per-IP login rate limit (brute-force protection).
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
# Seed administrator (created on first startup if no users exist).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
ORG_NAME=Default Organization
# DEMO_FEED injects LABELLED simulated vehicles for demos. Default is OFF (opt-in);
# set to true only for a local demo. It is always refused when APP_ENV=production.
# DEMO_FEED=false
