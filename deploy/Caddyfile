# Caddy reverse proxy for the API + dashboard.
# Set DOMAIN to your real hostname in .env for automatic HTTPS (Let's Encrypt).
# With the default "localhost", Caddy serves a local self-signed certificate.
#
# WebSocket upgrades (/api/ws/live) are proxied transparently by reverse_proxy.

{$DOMAIN:localhost} {
	encode gzip zstd

	# Health check passthrough.
	handle /api/health {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy api:8080
	}
}
